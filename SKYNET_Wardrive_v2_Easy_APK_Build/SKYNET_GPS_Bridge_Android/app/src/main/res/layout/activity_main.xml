<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#04080E"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKYNET"
            android:textColor="#00DCFF"
            android:textSize="34sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS BRIDGE v2"
            android:textColor="#EEF7FF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#0A131D"
            android:padding="16dp"
            android:text="Bridge stopped"
            android:textColor="#7D97AA"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/endpointText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0A131D"
            android:padding="16dp"
            android:text="Endpoint: :8765/gps"
            android:textColor="#00DCFF"
            android:textIsSelectable="true"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0A131D"
            android:padding="16dp"
            android:text="Waiting for GPS"
            android:textColor="#44FF9A"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="START GPS BRIDGE"/>

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOP BRIDGE"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Enable your phone hotspot, then start this bridge. GPS is served only on the local network and is not uploaded by this app."
            android:textColor="#7D97AA"
            android:textSize="14sp"/>
    </LinearLayout>
</ScrollView>
